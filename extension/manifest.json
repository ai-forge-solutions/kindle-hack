{
  "manifest_version": 3,
  "name": "Subrayados · sync de Kindle",
  "version": "0.1.0",
  "description": "Copia cada día tus subrayados del Notebook de Kindle a una página de Notion.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.co.uk/*",
    "https://read.amazon.de/*",
    "https://read.amazon.fr/*",
    "https://read.amazon.it/*",
    "https://read.amazon.es/*",
    "https://read.amazon.ca/*",
    "https://read.amazon.com.au/*",
    "https://read.amazon.in/*",
    "https://read.amazon.co.jp/*",
    "https://read.amazon.com.mx/*",
    "https://read.amazon.com.br/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subrayados"
  }
}
